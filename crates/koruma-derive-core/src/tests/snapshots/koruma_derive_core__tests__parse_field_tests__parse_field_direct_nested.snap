    FieldInfo {
        name: Ident {
            sym: inner,
        },
        member: Member::Named(
            Ident {
                sym: inner,
            },
        ),
        ty: Type::Path {
            qself: None,
            path: Path {
                leading_colon: None,
                segments: [
                    PathSegment {
                        ident: Ident {
                            sym: InnerStruct,
                        },
                        arguments: PathArguments::None,
                    },
                ],
            },
        },
        validation: ValidationInfo {
            field_validators: [],
            element_validators: [],
            is_nested: true,
            is_newtype: false,
        },
    },
)
