#[doc = concat!(
    "Validators for the `", "score", "` field of [`", "GenericItem", "`]: [`",
    "GenericRangeValidation", "`]."
)]
#[derive(Clone, Debug)]
#[allow(dead_code)]
pub enum GenericItemScoreKorumaValidator {
    GenericRangeValidation(GenericRangeValidation<f64>),
}
#[doc = concat!(
    "Validation errors for the `", "score", "` field of [`", "GenericItem",
    "`].\n\nValidators: [`", "GenericRangeValidation", "`]."
)]
#[derive(Clone, Debug, Default)]
pub struct GenericItemScoreKorumaValidationError {
    generic_range_validation: Option<GenericRangeValidation<f64>>,
}
impl GenericItemScoreKorumaValidationError {
    #[doc = concat!(
        "Returns the failed [`", "GenericRangeValidation", "`] validator, if any."
    )]
    pub fn generic_range_validation(&self) -> Option<&GenericRangeValidation<f64>> {
        self.generic_range_validation.as_ref()
    }
    #[doc = concat!("Returns all failed validators for `", "score", "`.")]
    pub fn all(&self) -> Vec<GenericItemScoreKorumaValidator> {
        let mut result = Vec::new();
        if let Some(v) = &self.generic_range_validation {
            result
                .push(
                    GenericItemScoreKorumaValidator::GenericRangeValidation(v.clone()),
                );
        }
        result
    }
    pub fn is_empty(&self) -> bool {
        self.generic_range_validation.is_none()
    }
    pub fn has_errors(&self) -> bool {
        !self.is_empty()
    }
}
#[doc = concat!(
    "Validation errors for [`", "GenericItem",
