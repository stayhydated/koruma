    #[doc = concat!("Returns all failed validators for `", "age", "`.")]
    pub fn all(&self) -> Vec<ItemAgeKorumaValidator> {
        let mut result = Vec::new();
        if let Some(v) = &self.number_range_validation {
            result.push(ItemAgeKorumaValidator::NumberRangeValidation(v.clone()));
        }
