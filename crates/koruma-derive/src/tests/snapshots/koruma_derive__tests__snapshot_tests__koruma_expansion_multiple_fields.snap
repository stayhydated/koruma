#[doc = concat!(
    "Validation errors for [`", "Item", "`].\n\nContains per-field error structs for ",
    "fields: `age`, `name`", "."
)]
#[derive(Clone, Debug, Default)]
pub struct ItemKorumaValidationError {
    age: ItemAgeKorumaValidationError,
    name: ItemNameKorumaValidationError,
}
impl ItemKorumaValidationError {
    #[doc = concat!(
        "Returns validation errors for the `", "age", "` field of [`", "Item", "`]."
    )]
    pub fn age(&self) -> &ItemAgeKorumaValidationError {
        &self.age
    }
    #[doc = concat!(
