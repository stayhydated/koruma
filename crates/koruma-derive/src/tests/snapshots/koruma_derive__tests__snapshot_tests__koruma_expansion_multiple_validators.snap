)]
#[derive(Clone, Debug)]
#[allow(dead_code)]
pub enum MultiValidatorItemValueKorumaValidator {
    NumberRangeValidation(NumberRangeValidation),
    EvenNumberValidation(EvenNumberValidation),
}
#[doc = concat!(
    "Validation errors for the `", "value", "` field of [`", "MultiValidatorItem",
    "`].\n\nValidators: [`", "NumberRangeValidation`], `[EvenNumberValidation", "`]."
)]
#[derive(Clone, Debug, Default)]
pub struct MultiValidatorItemValueKorumaValidationError {
    number_range_validation: Option<NumberRangeValidation>,
    even_number_validation: Option<EvenNumberValidation>,
}
impl MultiValidatorItemValueKorumaValidationError {
    #[doc = concat!(
        "Returns the failed [`", "NumberRangeValidation", "`] validator, if any."
    )]
    pub fn number_range_validation(&self) -> Option<&NumberRangeValidation> {
        self.number_range_validation.as_ref()
    }
    #[doc = concat!(
