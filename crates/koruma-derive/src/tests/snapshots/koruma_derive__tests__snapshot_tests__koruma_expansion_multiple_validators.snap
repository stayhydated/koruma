    )]
    pub fn even_number_validation(&self) -> Option<&EvenNumberValidation> {
        self.even_number_validation.as_ref()
    }
    #[doc = concat!("Returns all failed validators for `", "value", "`.")]
    pub fn all(&self) -> Vec<MultiValidatorItemValueKorumaValidator> {
        let mut result = Vec::new();
        if let Some(v) = &self.number_range_validation {
            result
                .push(
                    MultiValidatorItemValueKorumaValidator::NumberRangeValidation(
                        v.clone(),
                    ),
                );
        }
        if let Some(v) = &self.even_number_validation {
            result
                .push(
                    MultiValidatorItemValueKorumaValidator::EvenNumberValidation(
                        v.clone(),
                    ),
                );
        }
        result
    }
    pub fn is_empty(&self) -> bool {
        self.number_range_validation.is_none() && self.even_number_validation.is_none()
    }
    pub fn has_errors(&self) -> bool {
