#[doc = concat!(
    "Validators for the `", "score", "` field of [`", "Item", "`]: [`", "GenericRange",
    "`]."
)]
#[derive(Clone, Debug)]
#[allow(dead_code)]
pub enum ItemScoreKorumaValidator {
    GenericRange(GenericRange<i32>),
}
#[doc = concat!(
    "Validation errors for the `", "score", "` field of [`", "Item",
    "`].\n\nValidators: [`", "GenericRange", "`]."
)]
#[derive(Clone, Debug, Default)]
pub struct ItemScoreKorumaValidationError {
    generic_range: Option<GenericRange<i32>>,
}
impl ItemScoreKorumaValidationError {
    #[doc = concat!("Returns the failed [`", "GenericRange", "`] validator, if any.")]
    pub fn generic_range(&self) -> Option<&GenericRange<i32>> {
        self.generic_range.as_ref()
    }
    #[doc = concat!("Returns all failed validators for `", "score", "`.")]
    pub fn all(&self) -> Vec<ItemScoreKorumaValidator> {
        let mut result = Vec::new();
        if let Some(v) = &self.generic_range {
            result.push(ItemScoreKorumaValidator::GenericRange(v.clone()));
        }
        result
    }
    pub fn is_empty(&self) -> bool {
        self.generic_range.is_none()
    }
    pub fn has_errors(&self) -> bool {
        !self.is_empty()
    }
}
#[doc = concat!(
    "Validation errors for [`", "Item", "`].\n\nContains per-field error structs for ",
    "field: `score`", "."
)]
#[derive(Clone, Debug, Default)]
pub struct ItemKorumaValidationError {
    score: ItemScoreKorumaValidationError,
}
impl ItemKorumaValidationError {
    #[doc = concat!(
        "Returns validation errors for the `", "score", "` field of [`", "Item", "`]."
    )]
    pub fn score(&self) -> &ItemScoreKorumaValidationError {
        &self.score
    }
}
impl koruma::ValidationError for ItemKorumaValidationError {
    fn is_empty(&self) -> bool {
        self.score.is_empty()
    }
}
impl Item {
    #[doc = concat!(
        "Validates all fields of `", "Item",
        "` and returns an error struct containing all validation failures."
    )]
    pub fn validate(&self) -> Result<(), ItemKorumaValidationError> {
        let mut error = ItemKorumaValidationError {
            score: ItemScoreKorumaValidationError {
                generic_range: None,
            },
        };
        let mut has_error = false;
        if let Some(ref __field_value) = self.score {
            fn __koruma_assert_validate_score_generic_range_field<
                V: koruma::Validate<T>,
                T,
            >(v: &V, t: &T) -> bool {
                v.validate(t)
            }
            let validator = koruma::BuilderWithValueRef::with_value_ref(
                    GenericRange::<i32>::min(0).max(100),
                    __field_value,
                )
                .build();
            if !__koruma_assert_validate_score_generic_range_field(
                &validator,
                __field_value,
            ) {
                error.score.generic_range = Some(validator);
                has_error = true;
            }
        }
        if has_error { Err(error) } else { Ok(()) }
    }
}
impl koruma::ValidateExt for Item {
    type Error = ItemKorumaValidationError;
    fn validate(&self) -> Result<(), ItemKorumaValidationError> {
        Self::validate(self)
    }
}
