#[derive(koruma::bon::Builder)]
#[builder(crate = ::koruma::bon)]
#[derive(Clone, Debug)]
pub struct DirectValueValidation {
    min: i32,
    actual: i32,
}
impl DirectValueValidation {
    #[doc = concat!(
        "Returns the stored `", "actual", "` value captured by `#[koruma(value)]`."
    )]
    pub fn actual(&self) -> &i32 {
        &self.actual
    }
}
impl<S: direct_value_validation_builder::State> DirectValueValidationBuilder<S>
where
    S::Actual: koruma::bon::IsUnset,
{
    /// Sets the value field. This is auto-generated by `#[koruma::validator]`.
    pub fn with_value(
        self,
        value: i32,
    ) -> DirectValueValidationBuilder<direct_value_validation_builder::SetActual<S>> {
        self.actual(value)
    }
}
impl<S: direct_value_validation_builder::State> koruma::BuilderWithValueRef<i32>
for DirectValueValidationBuilder<S>
where
    S::Actual: koruma::bon::IsUnset,
    i32: ::std::clone::Clone,
{
    type Output = DirectValueValidationBuilder<
        direct_value_validation_builder::SetActual<S>,
    >;
    fn with_value_ref(self, value: &i32) -> Self::Output {
        self.with_value(value.clone())
    }
}
