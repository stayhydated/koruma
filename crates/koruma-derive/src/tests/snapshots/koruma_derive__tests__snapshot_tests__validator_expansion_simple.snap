#[derive(koruma::bon::Builder)]
#[builder(crate = ::koruma::bon)]
#[derive(Clone, Debug)]
pub struct NumberRangeValidation {
    min: i32,
    max: i32,
    actual: Option<i32>,
}
impl NumberRangeValidation {
    #[doc = concat!(
        "Returns the stored `", "actual", "` value captured by `#[koruma(value)]`."
    )]
    pub fn actual(&self) -> &Option<i32> {
        &self.actual
    }
}
impl<S: number_range_validation_builder::State> NumberRangeValidationBuilder<S>
where
    S::Actual: koruma::bon::IsUnset,
{
    /// Sets the value field. This is auto-generated by `#[koruma::validator]`.
    pub fn with_value(
        self,
        value: i32,
    ) -> NumberRangeValidationBuilder<number_range_validation_builder::SetActual<S>> {
        self.actual(value)
    }
}
impl<S: number_range_validation_builder::State> koruma::BuilderWithValueRef<i32>
for NumberRangeValidationBuilder<S>
where
    S::Actual: koruma::bon::IsUnset,
    i32: ::std::clone::Clone,
{
    type Output = NumberRangeValidationBuilder<
        number_range_validation_builder::SetActual<S>,
    >;
    fn with_value_ref(self, value: &i32) -> Self::Output {
        self.with_value(value.clone())
    }
}
