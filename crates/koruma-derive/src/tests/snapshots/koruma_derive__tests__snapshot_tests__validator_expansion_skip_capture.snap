#[derive(koruma::bon::Builder)]
#[builder(crate = ::koruma::bon)]
#[derive(Clone, Debug)]
pub struct PresenceOnlyValidation<T> {
    actual: Option<T>,
}
impl<T> PresenceOnlyValidation<T> {
    #[doc = concat!(
        "Returns the stored `", "actual", "` value captured by `#[koruma(value)]`."
    )]
    pub fn actual(&self) -> &Option<T> {
        &self.actual
    }
}
impl<T, S: presence_only_validation_builder::State> PresenceOnlyValidationBuilder<T, S>
where
    S::Actual: koruma::bon::IsUnset,
{
    /// Sets the value field. This is auto-generated by `#[koruma::validator]`.
    pub fn with_value(
        self,
        value: T,
    ) -> PresenceOnlyValidationBuilder<
        T,
        presence_only_validation_builder::SetActual<S>,
    > {
        self.actual(value)
    }
}
impl<T, S: presence_only_validation_builder::State> koruma::BuilderWithValueRef<T>
for PresenceOnlyValidationBuilder<T, S>
where
    S::Actual: koruma::bon::IsUnset,
{
    type Output = Self;
    fn with_value_ref(self, _value: &T) -> Self::Output {
        self
    }
}
