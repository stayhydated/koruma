{
  "name": "koruma",
  "private": true,
  "workspaces": [
    "web"
  ],
  "scripts": {
    "build": "turbo build",
    "build:wasm": "bun run build:wasm:collection",
    "build:wasm:collection": "cd examples/collection-web && wasm-pack build --release --target web --out-dir ../../web/public/collection-example --out-name collection-example",
    "build:web": "turbo run build --filter=web",
    "dev": "turbo dev",
    "fmt": "oxfmt",
    "lint": "oxlint"
  },
  "devDependencies": {
    "oxfmt": "^0.31.0",
    "oxlint": "^1.46.0",
    "turbo": "^2.8.7"
  },
  "packageManager": "bun@1.3.5"
}
