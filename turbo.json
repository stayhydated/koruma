{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build",
        "//#build:wasm",
        "//#build:book",
        "//#build:llms-txt"
      ],
      "outputs": ["dist/**", ".astro/**"]
    },
    "//#build:wasm": {
      "cache": true,
      "inputs": [
        "Cargo.toml",
        "Cargo.lock",
        "crates/**",
        "examples/collection-dioxus-web",
        "examples/collection-ratatui-core",
        "examples/collection-ratatui-web"
      ],
      "outputs": [
        "web/public/collection-dioxus-web/**",
        "web/public/collection-ratatui-web/**"
      ]
    },
    "//#build:book": {
      "cache": true,
      "inputs": ["book/**"],
      "outputs": ["web/public/book/**"]
    },
    "//#build:llms-txt": {
      "cache": true,
      "inputs": ["book/src/**"],
      "outputs": ["web/public/llms.txt"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
