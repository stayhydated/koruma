---
interface Props {
  moduleUrl: string;
  initExport?: string;
  loadingText?: string;
  errorText?: string;
}

const {
  moduleUrl,
  initExport = "default",
  loadingText = "Loading...",
  errorText = "Failed to load.",
} = Astro.props;
---

<div class="ratzilla-loader" data-state="loading">
  <div class="ratzilla-loader__status" data-state="loading" aria-live="polite">
    {loadingText}
  </div>
  <div class="ratzilla-loader__status" data-state="error" role="alert" aria-live="assertive">
    {errorText}
  </div>
</div>

<script is:inline define:vars={{ moduleUrl, initExport }}>
  // @ts-nocheck - Variables are injected by Astro's define:vars
  const root = document.currentScript?.previousElementSibling;
  const setState = (state) => {
    if (!root) {
      return;
    }
    root.dataset.state = state;
  };

  // Capture Tab so it stays inside the app
  const abortController = new AbortController();
  const handleKeyDown = (event) => {
    if (event.key !== "Tab") {
      return;
    }
    event.preventDefault();
  };
  document.addEventListener("keydown", handleKeyDown, {
    capture: true,
    signal: abortController.signal,
  });
  window.addEventListener(
    "pagehide",
    () => {
      abortController.abort();
    },
    { once: true }
  );

  (async () => {
    try {
      const module = await import(moduleUrl);
      const init = module[initExport];
      if (typeof init !== "function") {
        throw new Error(`Missing init export: ${initExport}`);
      }
      await init();
      setState("ready");
    } catch (error) {
      console.error(error);
      setState("error");
    }
  })();
</script>

<style>
  .ratzilla-loader {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    width: 100vw;
    margin: 0 auto;
    text-align: center;
    color: var(--color-text);
  }

  .ratzilla-loader__status {
    display: none;
  }

  .ratzilla-loader[data-state="loading"] .ratzilla-loader__status[data-state="loading"],
  .ratzilla-loader[data-state="error"] .ratzilla-loader__status[data-state="error"] {
    display: block;
  }

  .ratzilla-loader[data-state="ready"] {
    display: none;
  }

  :global(pre) {
    font-family: "Fira Code", monospace;
    font-size: 16px;
    margin: 0;
  }
</style>
