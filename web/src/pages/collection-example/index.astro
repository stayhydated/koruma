---
import WasmExampleLayout from "../../layouts/WasmExampleLayout.astro";
import RatzillaLoader from "../../components/RatzillaLoader.astro";

const baseUrl = import.meta.env.BASE_URL;
---

<WasmExampleLayout title="Collection Example - Koruma">
  <RatzillaLoader moduleUrl={`${baseUrl}/collection-example/koruma-collection-example.js`} />
</WasmExampleLayout>

<style>
  :global(body) {
    margin: 0;
    width: 100%;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    align-content: center;
    background-color: #121212;
  }
</style>
