---
import WasmExampleLayout from "@/layouts/WasmExampleLayout.astro";
import RatzillaLoader from "@/components/RatzillaLoader.astro";
import ContributeToCollection from "@/components/ContributeToCollection.astro";

const baseUrl = import.meta.env.BASE_URL;
---

<WasmExampleLayout title="Collection Example - Koruma">
  <ContributeToCollection />
  <RatzillaLoader moduleUrl={`${baseUrl}/collection-example/koruma_collection_example_web.js`} />
</WasmExampleLayout>

<style>
  :global(body) {
    margin: 0;
    width: 100%;
    height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    align-content: center;
    background-color: #000;
  }
</style>
