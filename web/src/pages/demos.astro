---
import Layout from "@/layouts/Layout.astro";
import DemoCard from "@/components/DemoCard.astro";
---

<Layout title="koruma - Demos">
  <div class="max-w-3xl mx-auto px-8 py-12">
    <h1 class="text-4xl font-bold text-primary mb-8 glow-primary">Demos</h1>
    
    <DemoCard href="/collection-ratatui-web/" title="koruma-collection - tui">
      <p class="description">
        Interactive TUI showcasing <a href="https://crates.io/crates/koruma-collection">koruma-collection</a> Koruma validators via <a href="https://ratatui.rs/">Ratatui</a> (<a href="https://ratatui.github.io/ratzilla/">Ratzilla</a>)
      </p>
    </DemoCard>
    
    <DemoCard href="/collection-dioxus-web/" title="koruma-collection - web">
      <p class="description">
        Interactive UI showcasing <a href="https://crates.io/crates/koruma-collection">koruma-collection</a> validators via <a href="https://dioxuslabs.com/">Dioxus</a>
      </p>
    </DemoCard>
  </div>
</Layout>

<style>
  .description {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .description a {
    color: var(--color-secondary);
    font-weight: 600;
    text-decoration: none;
  }

  .description a:hover {
    text-decoration: underline;
  }
</style>