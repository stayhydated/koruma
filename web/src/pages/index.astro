---
import Layout from "@/layouts/Layout.astro";

const baseUrl = import.meta.env.BASE_URL;
---

<Layout title="koruma Examples">
  <div class="max-w-3xl mx-auto">
    <h1 class="text-4xl font-bold text-primary mb-8 glow-primary">Examples</h1>
    <ul class="space-y-4">
      <li>
        <div class="relative p-6 bg-bg-card border border-accent/30 rounded-lg text-text transition-all duration-300 hover:border-accent hover:translate-x-1 border-glow-accent">
          <a href={`${baseUrl}/collection-ratatui-web/`} class="absolute inset-0" aria-label="koruma-collection Example"></a>
          <div class="text-xl font-semibold mb-2 text-accent glow-accent">
            koruma-collection - tui
          </div>
          <div class="text-sm text-text-muted">
            Interactive TUI showcasing <a href="https://crates.io/crates/koruma-collection" class="relative z-10 font-bold text-secondary no-underline hover:underline">koruma-collection</a> Koruma validators via <a href="https://ratatui.rs/" class="relative z-10 font-bold text-primary no-underline hover:underline">Ratatui</a> (<a href="https://ratatui.github.io/ratzilla/" class="relative z-10 font-bold text-primary no-underline hover:underline">Ratzilla</a>).
          </div>
        </div>
      </li>
      <li>
        <div class="relative p-6 bg-bg-card border border-accent/30 rounded-lg text-text transition-all duration-300 hover:border-accent hover:translate-x-1 border-glow-accent">
          <a href={`${baseUrl}/collection-dioxus-web/`} class="absolute inset-0" aria-label="Dioxus Example"></a>
          <div class="text-xl font-semibold mb-2 text-accent glow-accent">
            koruma-collection - web
          </div>
          <div class="text-sm text-text-muted">
            Interactive UI showcasing <a href="https://crates.io/crates/koruma-collection" class="relative z-10 font-bold text-secondary no-underline hover:underline">koruma-collection</a> validators via <a href="https://dioxuslabs.com/" class="relative z-10 font-bold text-primary no-underline hover:underline">Dioxus</a>.
          </div>
        </div>
      </li>
    </ul>
  </div>
</Layout>
